# =============================================================================
# JKExamSpark — .gitignore
# =============================================================================

# Environment variables — NEVER commit
.env
.env.local
.env.production
.env.staging

# Node.js / Next.js
node_modules/
.next/
out/
build/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Python / FastAPI
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
*.egg-info/
dist/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml
*.sqlite
*.db

# Alembic — keep versions but not cached pyc
backend/alembic/versions/__pycache__/

# Uploads (local dev only, use Supabase Storage in prod)
backend/uploads/
uploads/

# OS
.DS_Store
Thumbs.db
*.pem

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Testing
coverage/
test.db

# Vercel
.vercel

# Prisma (leftover from initial setup)
/src/generated/prisma

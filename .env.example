# =============================================================================
# JKExamSpark — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =============================================================================

# =============================================================================
# DATABASE (Supabase PostgreSQL — Free Tier)
# =============================================================================
# Transaction-mode pooler (use for app connections)
DATABASE_URL="postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

# Session-mode pooler (use for migrations / Alembic)
DATABASE_URL_SYNC="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# =============================================================================
# AUTHENTICATION
# =============================================================================
# Generate with: python3 -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY="CHANGE_THIS_TO_A_RANDOM_64_CHAR_HEX_STRING"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# SUPABASE (for file storage)
# =============================================================================
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_STORAGE_BUCKET="study-materials"

# =============================================================================
# BACKEND
# =============================================================================
BACKEND_CORS_ORIGINS=["http://localhost:3000","https://YOUR_VERCEL_APP.vercel.app"]
ENVIRONMENT="development"  # development | production
DEBUG=true

# =============================================================================
# FRONTEND (Next.js)
# =============================================================================
NEXT_PUBLIC_API_URL="http://localhost:8000"
# In production, set to your Railway backend URL:
# NEXT_PUBLIC_API_URL="https://jkexamspark-backend.railway.app"

# =============================================================================
# ADMIN SETUP (first admin user seeded on startup)
# =============================================================================
FIRST_ADMIN_EMAIL="admin@jkexamspark.com"
FIRST_ADMIN_PASSWORD="CHANGE_THIS_STRONG_PASSWORD"
FIRST_ADMIN_FULL_NAME="Platform Admin"

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# FILE UPLOAD LIMITS
# =============================================================================
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=["application/pdf","image/jpeg","image/png","image/webp"]

# =============================================================================
# DOCKER (only used with docker-compose)
# =============================================================================
POSTGRES_USER=jkexamspark
POSTGRES_PASSWORD=jkexamspark_dev_password
POSTGRES_DB=jkexamspark
